# ==============================================================================
# Frontend (Vite) Environment Variables
# ==============================================================================
# In Vite, all environment variables accessible to the browser MUST start with VITE_

# 1. Backend API Base URL
# For local development with Vite proxy: leave blank or set to /api
# For production (Vercel, Netlify, GitHub Pages, etc.):
# Set this to your deployed backend URL (e.g., https://your-backend.onrender.com/api)
VITE_API_URL=https://your-backend-app.onrender.com/api

